"A.3" [label="A.3 引理\n沿路径的子句插入界", fillcolor="#fff8ec", URL="../A.3.html"];
}
subgraph cluster_tensor { label="张量缩并"; fontname="Noto Sans CJK SC"; fontsize=12; color="#3970a8"; style=rounded;
"D.1" [label="D.1 定理\n布尔张量网络快速收缩", fillcolor="#edf5ff", URL="../D.1.html"];
