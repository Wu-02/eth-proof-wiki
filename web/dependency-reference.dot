digraph ProofDependency {
graph [rankdir=LR, bgcolor="white", pad=.25, nodesep=.2, ranksep=.35, compound=true];
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10, margin=".12,.09", color="#728071"];
edge [color="#76867a", arrowsize=.65, penwidth=.85];
subgraph cluster_common { label="公共代数工具"; fontname="Noto Sans CJK SC"; fontsize=12; color="#6f5799"; style=rounded;
"5.1" [label="5.1 引理\n2^ℓ 模偶性指示多项式", fillcolor="#f7f2ff", URL="../5.1.html"];
