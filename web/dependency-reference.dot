"B.1" [label="B.1 引理\n整数提升系数高度界", fillcolor="#f7f2ff", URL="../B.1.html"];
}
subgraph cluster_sparsity { label="SAT 稀疏化与校验工具"; fontname="Noto Sans CJK SC"; fontsize=12; color="#95672c"; style=rounded;
"6.1" [label="6.1 引理\n稀疏初始奇偶校验", fillcolor="#fff8ec", URL="../6.1.html"];
